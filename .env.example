# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=open_helpdesk
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=1d

# Frontend
FRONTEND_URL=http://localhost:5173

# Email — Outbound (SMTP)
# Used for sending notifications (ticket created, assigned, comments, password reset, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Open Helpdesk <noreply@example.com>
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Email — Outbound (Postmark) — set EMAIL_PROVIDER=postmark to use
# POSTMARK_SERVER_TOKEN=

# Email — Threading
# Domain used in Message-ID headers for email threading (e.g. example.com).
# When set, all outgoing emails include threading headers so replies are grouped
# in the recipient's email client. Optional — emails work without it.
# EMAIL_DOMAIN=example.com

# Email — Inbound
# Enables email-to-ticket: customers send an email and a ticket is created automatically.
# Choose ONE method: MTA Hook (Stalwart) or IMAP (any mail server). Both can coexist.
#
# SUPPORT_EMAIL_DOMAIN: domain for workspace support addresses.
# Each workspace gets {slug}@{SUPPORT_EMAIL_DOMAIN} as its support email.
# Required for inbound email to work (both MTA Hook and IMAP).
# SUPPORT_EMAIL_DOMAIN=support.example.com

# --- Option A: MTA Hook (for Stalwart mail server) ---
# Stalwart sends a POST request to /inbound/email when an email arrives.
# Configure the MTA Hook in Stalwart pointing to your backend URL.
# MTA_HOOK_USER=mta-hook
# MTA_HOOK_SECRET=your-secret-here

# --- Option B: IMAP Polling (works with any mail server) ---
# The backend connects to an IMAP mailbox and reads unread emails periodically.
# No webhooks or special server configuration needed — just IMAP credentials.
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_USER=support@example.com
# IMAP_PASS=
# IMAP_TLS=true
# IMAP_FOLDER=INBOX
# IMAP_POLL_INTERVAL=30

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Admin seed
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=user1234
