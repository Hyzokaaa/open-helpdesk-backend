# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=open_helpdesk
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# JWT
JWT_SECRET=your-secret-key-change-in-production
# Lifetime of tokens issued by the API token exchange (/api/v1/auth/exchange) to integrations.
# Formerly JWT_EXPIRATION, which is still read when this one is not set.
API_TOKEN_EXCHANGE_EXPIRATION=1d

# Sessions (optional, these are the defaults)
# Access tokens are short-lived and renewed silently with a refresh token.
SESSION_ACCESS_TOKEN_EXPIRATION=15m
# Without "keep me signed in", counted from sign-in
SESSION_TTL_HOURS=24
# With "keep me signed in", extended on every use
SESSION_REMEMBER_TTL_DAYS=30

# Sign-in with Google / Microsoft (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# A provider sign-in reaches an existing account only when the provider verified the email.
# Microsoft never vouches for the profile email, so Microsoft sign-in cannot open an account
# that already exists with that address (new accounts are created and must verify their email).
# Set to true to link on unverified emails anyway. Anyone who can put your address on a
# Microsoft account can then sign in as you, so leave it off unless you trust every tenant.
# OAUTH_LINK_UNVERIFIED_EMAILS=false

# Frontend
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://other.example.com

# Email — Outbound (SMTP)
# Used for sending notifications (ticket created, assigned, comments, password reset, etc.)
# Can also be configured from Admin → Settings in the UI.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Open Helpdesk <noreply@example.com>

# Email — Outbound (Postmark) — set EMAIL_PROVIDER=postmark to use
# POSTMARK_SERVER_TOKEN=

# Email — Inbound
# Emails are received via IMAP mailboxes configured from the UI (Workspace → Settings → Mailboxes).
# No env vars needed — all IMAP configuration is done from the UI.
#
# SUPPORT_EMAIL_DOMAIN (optional): auto-creates a support address for each workspace.
# Each workspace gets {slug}@{SUPPORT_EMAIL_DOMAIN} as its support email.
# If a Platform Mailbox is configured in Admin → Settings, this is derived automatically.
# SUPPORT_EMAIL_DOMAIN=support.example.com

# Storage
# STORAGE_PROVIDER=filesystem uses local disk (no S3/MinIO needed). Default: S3.
# STORAGE_PATH is the directory for filesystem storage (default: ./data/storage).
# STORAGE_PROVIDER=filesystem
# STORAGE_PATH=./data/storage

# Largest attachment accepted per upload, in megabytes (default: 25). Bigger files get a 413.
# ATTACHMENT_MAX_SIZE_MB=25

# S3 (default storage provider, also works with MinIO or any S3-compatible service)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI (optional — enables Improve, Translate, and Improve & Translate features)
# Works with any OpenAI-compatible API: Groq, OpenAI, Together, Ollama, etc.
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Admin seed
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=user1234
